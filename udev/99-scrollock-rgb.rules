# scrollock-rgb: ScrollLock-driven RGB keyboards (e.g. SEMICO 1a2c:6003).
# Installed to /etc/udev/rules.d/99-scrollock-rgb.rules, then:
#   pkexec udevadm control --reload-rules
#   pkexec udevadm trigger --subsystem-match=leds
#
# TAG+="uaccess" does NOT help here: it grants ACLs on /dev nodes, not on
# sysfs LED attributes. Runtime sysfs writes therefore go through pkexec, and
# the boot guard runs as root from the system service.
#
# Boot/plug: detach the kernel auto-follow trigger and force the ScrollLock
# LED on (RGB on). Fires as root on device add, so no authentication is needed.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*::scrolllock", RUN+="/bin/sh -c 'echo none > /sys%p/trigger; echo 1 > /sys%p/brightness'"

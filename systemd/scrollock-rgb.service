[Unit]
Description=scrollock-rgb guard: keep ScrollLock RGB in sync, repair Caps/Num kills
Documentation=https://github.com/Peter5235252/scrollock-rgb
After=local-fs.target
# The guard rediscovers keyboards continuously, so it does not need to wait
# for udev to settle (that target is deprecated and slows boot).

[Service]
Type=simple
# Persistent guard: follows the desktop's ScrollLock LED and repairs Caps/Num
# kills within one poll. It does not enforce its own toggle, so it cannot
# fight Hyprland/KDE and cause flicker. Runs as root (system unit), so no
# password is needed. Add --suppress-lock-leds only for firmware that really
# cuts RGB when a Caps/Num indicator LED is lit. For an old compositor that
# does not handle ScrollLock at all, add --emulate-toggle (may flicker).
ExecStart=/usr/local/bin/scrollock-rgb guard --interval-ms 50
Restart=always
RestartSec=1
Nice=10

[Install]
WantedBy=multi-user.target

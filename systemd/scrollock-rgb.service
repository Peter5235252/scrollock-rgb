[Unit]
Description=scrollock-rgb guard: keep ScrollLock RGB on, Caps/Num can never kill it
Documentation=file:/home/csemanpeter/Projektek/scrollock-rgb/README.md
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
# Persistent guard: follows your ScrollLock toggle, repairs Caps/Num kills
# within one poll, keeps Caps/Num lights off (firmware latch prevention).
# Runs as root (system unit) so no sudo/password is needed.
ExecStart=/usr/local/bin/scrollock-rgb guard --interval-ms 50
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
